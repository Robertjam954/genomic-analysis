data_private/

# ─── Data directories (large / generated) ─────────────────────────
data/raw/
data/interim/
data/external/

# ─── Output directories ──────────────────────────────────────────
output/
output_*/
datasets_analysis_dictionary/output/

# ─── Reports (generated figures and tables) ───────────────────────
reports/figures/*
reports/tables/*
!reports/figures/.gitkeep
!reports/tables/.gitkeep

# ─── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
